# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the two required values. Then run
# `npm run doctor` - it checks everything and tells you what's still missing.
# ---------------------------------------------------------------------------

# --- Required: your database ------------------------------------------------
# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- Who this app is for ----------------------------------------------------
# Everything below is optional - leave it out and you get Tydie Cleaning's
# defaults. Setting these is how one codebase serves a different business
# without a code change. See src/lib/business.js for the full list and what
# each one does.
#
# VITE_BUSINESS_NAME=Tydie Cleaning
# VITE_BUSINESS_SHORT_NAME=Tydie
# VITE_BUSINESS_TAGLINE=Window, pressure and solar panel cleaning
# VITE_BUSINESS_DESCRIPTION=Window cleaning, pressure cleaning, and more. Request a free quote online.
# VITE_THEME_COLOR=#0068ab

# Shown on the public site as a tap-to-call button. Unset = button hidden.
VITE_BUSINESS_PHONE=0418 439 795
VITE_BUSINESS_EMAIL=jobs@tydiecleaning.com

# --- Money and distance -----------------------------------------------------
# VITE_CURRENCY_SYMBOL=$
# VITE_MILEAGE_RATE_CENTS=88
# VITE_DISTANCE_UNIT=km

# --- What this trade calls things -------------------------------------------
# A cleaner does a "clean", a sparky does a "job", a groomer does an
# "appointment". These words appear in headings and buttons throughout.
# VITE_WORD_SERVICE=clean
# VITE_WORD_SERVICE_PLURAL=cleans
# VITE_WORD_JOB=job
# VITE_WORD_JOB_PLURAL=jobs

# --- Switch off what this trade doesn't need --------------------------------
# Set any of these to `off` to hide that feature entirely. Removing what
# someone will never open is the fastest way to make software feel simple.
# VITE_FEATURE_MILEAGE=off
# VITE_FEATURE_QUOTES=off
# VITE_FEATURE_EXPENSES=off
# VITE_FEATURE_LEADS=off
# VITE_FEATURE_RECURRING=off
# VITE_FEATURE_WEATHER=off
# VITE_FEATURE_PUBLIC_BOOKING=off
